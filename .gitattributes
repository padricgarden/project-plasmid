# Normalize line endings for text files; Godot writes LF.
* text=auto eol=lf

# Godot text formats — keep them diffable.
*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.cfg       text eol=lf
*.import    text eol=lf
*.md        text eol=lf

# Binary assets — never touch these.
*.png       binary
*.jpg       binary
*.webp      binary
*.ogg       binary
*.wav       binary
*.ttf       binary
*.otf       binary
*.res       binary
*.ctex      binary
*.pck       binary
*.exe       binary
